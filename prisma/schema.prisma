generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: "MASTER" | "EDITOR" | "VIEWER" (ver lib/roles.ts)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("VIEWER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdVehicles    Vehicle[]     @relation("VehicleCreatedBy")
  importBatches      ImportBatch[]
  fuelRecordsCreated FuelRecord[]  @relation("FuelRecordCreatedBy")
  fuelRecordsUpdated FuelRecord[]  @relation("FuelRecordUpdatedBy")
  activityLogs       ActivityLog[]
}

model Vehicle {
  id               String   @id @default(cuid())
  placa            String   @unique
  marca            String?
  modelo           String?
  anoModelo        Int?
  anoFabricacao    Int?
  tipoVeiculo      String?
  capacidadeTanque Float?
  ativo            Boolean  @default(true)
  metaManual       Float?
  createdById      String?
  createdBy        User?    @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fuelRecords FuelRecord[]

  @@index([marca, modelo])
}

model ImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  importedById String?
  importedBy   User?    @relation(fields: [importedById], references: [id])
  totalRows    Int      @default(0)
  errorRows    Int      @default(0)
  createdAt    DateTime @default(now())

  fuelRecords FuelRecord[]
}

// Combustivel: "DIESEL" | "DIESEL_S10" | "GASOLINA" | "ETANOL" | "GNV" | "ARLA" | "LUBRIFICANTE" | "OUTRO" (ver lib/roles.ts)
// Origem: "INTERNO" | "EXTERNO" (ver lib/roles.ts)
model FuelRecord {
  id          String    @id @default(cuid())
  placaTexto  String
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  data        DateTime?
  km          Float?
  litros      Float?
  valorLitro  Float?
  valorTotal  Float?
  posto       String?
  combustivel String    @default("DIESEL")
  origem      String    @default("EXTERNO")
  motorista   String?
  observacao  String?

  hasError  Boolean @default(false)
  errors    String  @default("[]")
  corrected Boolean @default(false)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdById String?
  createdBy   User?   @relation("FuelRecordCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("FuelRecordUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([data])
  @@index([hasError])
}

// Tipo: "IMPORTACAO" | "CORRECAO" | "EXCLUSAO" | "VEICULO" | "META" | "USUARIO" (ver lib/roles.ts)
model ActivityLog {
  id        String   @id @default(cuid())
  tipo      String
  descricao String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([tipo])
}
