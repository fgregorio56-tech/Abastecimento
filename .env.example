# Banco de dados (PostgreSQL)
# Local: instale o Postgres e crie um banco, ou use um provedor gratuito na
# nuvem (ex.: Neon, Supabase) e cole a "connection string" fornecida por ele.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/abastecimento?schema=public"

# Gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-este-valor"
NEXTAUTH_URL="http://localhost:3000"

# Usuário mestre criado pelo `npx prisma db seed`
MASTER_EMAIL="admin@suaempresa.com"
MASTER_PASSWORD="troque-esta-senha"
MASTER_NAME="Administrador"
