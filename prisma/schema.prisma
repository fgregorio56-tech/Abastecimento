generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: "MASTER" (Administrador) | "USUARIO" (acesso por módulo) — ver lib/roles.ts
// Modulos: {"ABASTECIMENTO": "VIEWER" | "EDITOR" | "SUPERVISOR", "ROTINA": ...} — ver lib/permissions.ts
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USUARIO")
  modulos      Json     @default("{}")
  active       Boolean  @default(true)
  supervisorId String?
  supervisor   User?    @relation("Equipe", fields: [supervisorId], references: [id])
  equipe       User[]   @relation("Equipe")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdVehicles    Vehicle[]     @relation("VehicleCreatedBy")
  importBatches      ImportBatch[]
  fuelRecordsCreated FuelRecord[]  @relation("FuelRecordCreatedBy")
  fuelRecordsUpdated FuelRecord[]  @relation("FuelRecordUpdatedBy")
  activityLogs       ActivityLog[]

  rotinas              Rotina[]         @relation("RotinaResponsavel")
  rotinasCriadas       Rotina[]         @relation("RotinaCriadaPor")
  registrosResponsavel RotinaRegistro[] @relation("RegistroResponsavel")
  registrosFeitos      RotinaRegistro[] @relation("RegistroPor")
  extrasResponsavel    RotinaExtra[]    @relation("ExtraResponsavel")
  extrasFeitos         RotinaExtra[]    @relation("ExtraPor")
}

model Vehicle {
  id               String   @id @default(cuid())
  placa            String   @unique
  marca            String?
  modelo           String?
  anoModelo        Int?
  anoFabricacao    Int?
  tipoVeiculo      String?
  capacidadeTanque Float?
  unidade          String?
  ativo            Boolean  @default(true)
  metaManual       Float?
  createdById      String?
  createdBy        User?    @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fuelRecords FuelRecord[]

  @@index([marca, modelo])
}

model ImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  importedById String?
  importedBy   User?    @relation(fields: [importedById], references: [id])
  totalRows    Int      @default(0)
  errorRows    Int      @default(0)
  createdAt    DateTime @default(now())

  fuelRecords FuelRecord[]
}

// Combustivel: "DIESEL" | "DIESEL_S10" | "GASOLINA" | "ETANOL" | "GNV" | "ARLA" | "LUBRIFICANTE" | "OUTRO" (ver lib/roles.ts)
// Origem: "INTERNO" | "EXTERNO" (ver lib/roles.ts)
model FuelRecord {
  id               String    @id @default(cuid())
  placaTexto       String
  vehicleId        String?
  vehicle          Vehicle?  @relation(fields: [vehicleId], references: [id])
  data             DateTime?
  km               Float?
  litros           Float?
  valorLitro       Float?
  valorTotal       Float?
  posto            String?
  combustivel      String    @default("DIESEL")
  kmAnteriorManual Float?
  origem           String    @default("EXTERNO")
  motorista        String?
  observacao       String?

  hasError  Boolean @default(false)
  errors    String  @default("[]")
  corrected Boolean @default(false)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdById String?
  createdBy   User?   @relation("FuelRecordCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("FuelRecordUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([data])
  @@index([hasError])
}

// Tipo: "IMPORTACAO" | "CORRECAO" | "EXCLUSAO" | "VEICULO" | "META" | "USUARIO" (ver lib/roles.ts)
model ActivityLog {
  id        String   @id @default(cuid())
  tipo      String
  descricao String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([tipo])
}

// ---------------------------------------------------------------------------
// Módulo Check de rotina
// ---------------------------------------------------------------------------

// Frequencia: "SEMANAL" (usa diasSemana, 0 = domingo) | "MENSAL" (usa diaMes)
model Rotina {
  id            String   @id @default(cuid())
  titulo        String
  local         String?
  horario       String?
  frequencia    String   @default("SEMANAL")
  diasSemana    Int[]
  diaMes        Int?
  ativo         Boolean  @default(true)
  inicio        DateTime @db.Date
  responsavelId String
  responsavel   User     @relation("RotinaResponsavel", fields: [responsavelId], references: [id])
  createdById   String?
  createdBy     User?    @relation("RotinaCriadaPor", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  registros RotinaRegistro[]

  @@index([responsavelId])
}

// Status: "FEITO" | "NAO_FEITO" — uma linha por rotina por dia
model RotinaRegistro {
  id              String   @id @default(cuid())
  rotinaId        String
  rotina          Rotina   @relation(fields: [rotinaId], references: [id], onDelete: Cascade)
  data            DateTime @db.Date
  status          String
  motivo          String?
  justificativa   String?
  responsavelId   String
  responsavel     User     @relation("RegistroResponsavel", fields: [responsavelId], references: [id])
  registradoPorId String?
  registradoPor   User?    @relation("RegistroPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([rotinaId, data])
  @@index([data])
  @@index([responsavelId])
}

model RotinaExtra {
  id              String   @id @default(cuid())
  data            DateTime @db.Date
  descricao       String
  observacao      String?
  responsavelId   String
  responsavel     User     @relation("ExtraResponsavel", fields: [responsavelId], references: [id])
  registradoPorId String?
  registradoPor   User?    @relation("ExtraPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@index([data])
  @@index([responsavelId])
}
